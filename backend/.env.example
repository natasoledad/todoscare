# PostgreSQL (async driver)
DATABASE_URL=postgresql+asyncpg://todoscare:todoscare@localhost:5432/todoscare

# JWT
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# CORS
CORS_ORIGINS=http://localhost:5173

# IA clínica (72.4) — opcional. Si defines la API key, el conector "ia_clinica"
# lee el CONTENIDO real del examen con un modelo Claude; si queda vacía, usa el
# heurístico. Además hay que activar el conector en Admin → Integraciones.
ANTHROPIC_API_KEY=
IA_MODEL=claude-haiku-4-5-20251001
